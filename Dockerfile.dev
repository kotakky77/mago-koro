# 開発環境用イメージ。
# node:22-bookworm-slim には ca-certificates が入っておらず、workerd（wrangler dev）が
# 外部TLS接続（Gmail API等）で「TLS peer's certificate is not trusted」になるため追加する。
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
